+// ARMv8.0 (no sdot): q4 x q8 products are at most 8*128, so 4 per lane fit in int16.
+// smull + 3 smlal + saddlp per block instead of 4 smull + 4 sadalp.
+static inline int32x4_t ggml_q4_q8_block_dot(int8x16_t xl, int8x16_t xh, int8x16_t yl, int8x16_t yh) {
+    int16x8_t p = vmull_s8(vget_low_s8(xl), vget_low_s8(yl));
+    p = vmlal_high_s8(p, xl, yl);
+    p = vmlal_s8(p, vget_low_s8(xh), vget_low_s8(yh));
+    p = vmlal_high_s8(p, xh, yh);
+    return vpaddlq_s16(p);
+}
+
+// q8 x q8 products are at most 127*127, so 2 per lane fit in int16 (q8_0 values are quantized to [-127, 127]).
+static inline int32x4_t ggml_q8_q8_block_dot(int8x16_t x0, int8x16_t x1, int8x16_t y0, int8x16_t y1) {
+    const int16x8_t p0 = vmlal_high_s8(vmull_s8(vget_low_s8(x0), vget_low_s8(y0)), x0, y0);
+    const int16x8_t p1 = vmlal_high_s8(vmull_s8(vget_low_s8(x1), vget_low_s8(y1)), x1, y1);
+    return vpadalq_s16(vpaddlq_s16(p0), p1);
+}
+#endif
