+        for (int i = 0; i < nb; i++) {
+            const uint8x16_t q0 = vld1q_u8(vx0[i].qs);
+            const uint8x16_t q1 = vld1q_u8(vx1[i].qs);
+            const int8x16_t x0l = vsubq_s8(vreinterpretq_s8_u8(vandq_u8(q0, m4b)), s8b);
+            const int8x16_t x0h = vsubq_s8(vreinterpretq_s8_u8(vshrq_n_u8(q0, 4)), s8b);
+            const int8x16_t x1l = vsubq_s8(vreinterpretq_s8_u8(vandq_u8(q1, m4b)), s8b);
+            const int8x16_t x1h = vsubq_s8(vreinterpretq_s8_u8(vshrq_n_u8(q1, 4)), s8b);
+
+            const int8x16_t y0l = vld1q_s8(vy0[i].qs);
+            const int8x16_t y0h = vld1q_s8(vy0[i].qs + 16);
+            const int8x16_t y1l = vld1q_s8(vy1[i].qs);
+            const int8x16_t y1h = vld1q_s8(vy1[i].qs + 16);
+
+            const float dx0 = GGML_CPU_FP16_TO_FP32(vx0[i].d);
