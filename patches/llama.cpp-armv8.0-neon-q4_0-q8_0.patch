+            acc11 = vmlaq_n_f32(acc11, vcvtq_f32_s32(ggml_q4_q8_block_dot(x1l, x1h, y1l, y1h)), dx1*dy1);
+        }
+
+        s[0]      = vaddvq_f32(acc00);
+        s[1]      = vaddvq_f32(acc10);
